-            CHECK_ERR
-
-            // Time dim is always 0, but block size should be 1
-            if (dsize[i] == 0) dsize[i] = 1;
-            var->dims[i] = dsize[i];
-            vsize *= dsize[i];
-        }
-
-        // flatten into 1 dim only apply to non-scalar variables
-        if (ndims){
-            // Convert into byte array
-            err = e3sm_io_xlen_nc_type(xtype, &esize);
-            CHECK_MPIERR
-            vsize *= esize;
