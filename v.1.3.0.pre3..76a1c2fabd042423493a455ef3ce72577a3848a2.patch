+            GET_GATTR_INT("num_subfiles", &cfg.num_subfiles)
+        }
+    }
+
+    /* save number of processes as global attributes */
+    GET_GATTR_INT("ne", &intBuf)
+    GET_GATTR_INT("np", &intBuf)
+
+    txtBuf[0] = '\0';
