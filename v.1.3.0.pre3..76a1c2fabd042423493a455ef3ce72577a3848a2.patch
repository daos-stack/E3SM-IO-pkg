-            CHECK_ERR
-
-            // NetCDF type enum
-            ibuf = xtype;
-            err = driver.put_att(fid, var->vid, "__pio__/nctype", NC_INT, 1,
-                                 &ibuf);
-            CHECK_ERR
-
-            // Number of dimensions
-            err = driver.put_att(fid, var->vid, "__pio__/ndims", NC_INT, 1,
-                                 &ndims);
-            CHECK_ERR
-        }
-
-        var->decom_id   = -1;
-        var->frame_id   = -1;
-        var->fillval_id = -1;
-    }
-err_out:
-    return err;
-}
