+
+for API in "${APIS[@]}" ; do
+    ap=($API)
+
+    for CONFIG in "${CONFIGS[@]}" ; do
+        IN_FILE="${srcdir}/datasets/${CONFIG}"
+        OUT_FILE_BASE="${TESTOUTDIR}/${ap[0]}_${ap[1]}_${CONFIG}"
+        if test "x${ap[0]}" = xpnetcdf ; then
+           FILE_EXT="nc"
+           IN_FILE+=".${FILE_EXT}"
+        elif test "x${ap[0]}" = xnetcdf4 ; then
