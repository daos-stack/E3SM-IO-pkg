+int e3sm_io_driver_hdf5_log::get_varn (int fid,
+                                       int vid,
+                                       MPI_Datatype itype,
+                                       int nreq,
+                                       MPI_Offset **starts,
+                                       MPI_Offset **counts,
+                                       void *buf,
+                                       e3sm_io_op_mode mode) {
