+            cat ${GITHUB_WORKSPACE}/LOGVOL/vol-log-based-logvol.${LOG_VOL_VERSION}/qout
+            cat ${GITHUB_WORKSPACE}/LOGVOL/vol-log-based-logvol.${LOG_VOL_VERSION}/config.log
+        - name: Build and check E3SM_IO with PnetCDF only
